@model IEnumerable<ElCortijo.Dominio.Entidades.Cliente>
@{ ViewData["Title"] = "Clientes"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <div><h2 class="fw-bold mb-1">Clientes</h2><p class="text-muted small mb-0">Registro y administracion de clientes</p></div>
    <a asp-action="Crear" class="btn btn-primary"><i class="bi bi-person-plus-fill me-1"></i> Nuevo cliente</a>
</div>
@if (TempData["Exito"] is string mensaje) { <div class="alert alert-success">@mensaje</div> }

<form method="get" class="card border-0 shadow-sm mb-4 filter-card"><div class="card-body p-4">
    <div class="d-flex align-items-center gap-2 mb-3"><i class="bi bi-funnel-fill text-primary"></i><h6 class="fw-bold mb-0">Filtros de busqueda</h6></div>
    <div class="filter-grid">
        <div class="filter-control filter-control-wide"><label class="filter-label" for="buscar">BUSCAR CLIENTE</label><div class="input-group"><span class="input-group-text bg-white"><i class="bi bi-search text-muted"></i></span><input id="buscar" name="buscar" value="@ViewBag.Buscar" class="form-control" placeholder="Documento, nombre o contacto" /></div></div>
        <div class="filter-control"><label class="filter-label" for="tipoDocumento">TIPO DE DOCUMENTO</label><select id="tipoDocumento" name="tipoDocumento" class="form-select"><option value="">Todos los tipos</option><option value="DNI" selected="@(ViewBag.TipoDocumento == "DNI")">DNI</option><option value="RUC" selected="@(ViewBag.TipoDocumento == "RUC")">RUC</option></select></div>
        <div class="filter-control filter-control-small"><label class="filter-label" for="estado">ESTADO</label><select id="estado" name="estado" class="form-select"><option value="">Todos</option><option value="activo" selected="@(ViewBag.Estado == "activo")">Activo</option><option value="inactivo" selected="@(ViewBag.Estado == "inactivo")">Inactivo</option></select></div>
        <div class="filter-actions"><a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-funnel-slash me-1"></i> Limpiar</a><button class="btn btn-primary" type="submit"><i class="bi bi-search me-1"></i> Buscar</button></div>
    </div>
</div></form>

<div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table table-hover align-middle mb-0">
    <thead class="table-light"><tr><th>Documento</th><th>Nombre / Razon social</th><th>Contacto</th><th>Estado</th><th class="text-end">Acciones</th></tr></thead>
    <tbody>
    @if (Model.Any())
    {
        foreach (var cliente in Model)
        {
            <tr>
                <td><span class="badge bg-secondary">@cliente.TipoDocumento</span> @cliente.NumeroDocumento</td>
                <td class="fw-semibold">@cliente.NombreRazonSocial<br /><small class="text-muted">@(cliente.Direccion ?? "Sin direccion")</small></td>
                <td>@(cliente.Telefono ?? "-")<br /><small class="text-muted">@(cliente.Correo ?? "-")</small></td>
                <td><span class="badge @(cliente.Estado ? "bg-success" : "bg-secondary")">@(cliente.Estado ? "Activo" : "Inactivo")</span></td>
                <td class="text-end"><a asp-action="Editar" asp-route-id="@cliente.IdCliente" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a> <form asp-action="CambiarEstado" asp-route-id="@cliente.IdCliente" method="post" class="d-inline"><button class="btn btn-sm @(cliente.Estado ? "btn-outline-warning" : "btn-outline-success")" title="@(cliente.Estado ? "Desactivar" : "Activar")"><i class="bi @(cliente.Estado ? "bi-slash-circle" : "bi-check-circle")"></i></button></form></td>
            </tr>
        }
    }
    else
    {
        <tr><td colspan="5" class="text-center text-muted py-4"><i class="bi bi-search d-block fs-3 mb-2"></i>No se encontraron clientes con los filtros seleccionados.</td></tr>
    }
    </tbody>
</table></div></div>

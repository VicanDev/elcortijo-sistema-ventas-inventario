@model IEnumerable<ElCortijo.Dominio.Entidades.Cliente>
@{ ViewData["Title"] = "Clientes"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <div><h2 class="fw-bold mb-1">Clientes</h2><p class="text-muted small mb-0">Registro y administración de clientes</p></div>
    <a asp-action="Crear" class="btn btn-primary"><i class="bi bi-person-plus-fill me-1"></i> Nuevo cliente</a>
</div>
@if (TempData["Exito"] is string mensaje) { <div class="alert alert-success">@mensaje</div> }
<div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table table-hover align-middle mb-0">
    <thead class="table-light"><tr><th>Documento</th><th>Nombre / Razón social</th><th>Contacto</th><th>Estado</th><th class="text-end">Acciones</th></tr></thead>
    <tbody>@foreach (var cliente in Model) { <tr>
        <td><span class="badge bg-secondary">@cliente.TipoDocumento</span> @cliente.NumeroDocumento</td>
        <td class="fw-semibold">@cliente.NombreRazonSocial<br /><small class="text-muted">@(cliente.Direccion ?? "Sin dirección")</small></td>
        <td>@(cliente.Telefono ?? "-")<br /><small class="text-muted">@(cliente.Correo ?? "-")</small></td>
        <td><span class="badge @(cliente.Estado ? "bg-success" : "bg-secondary")">@(cliente.Estado ? "Activo" : "Inactivo")</span></td>
        <td class="text-end"><a asp-action="Editar" asp-route-id="@cliente.IdCliente" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a>
        <form asp-action="CambiarEstado" asp-route-id="@cliente.IdCliente" method="post" class="d-inline"><button class="btn btn-sm @(cliente.Estado ? "btn-outline-warning" : "btn-outline-success")" title="@(cliente.Estado ? "Desactivar" : "Activar")"><i class="bi @(cliente.Estado ? "bi-slash-circle" : "bi-check-circle")"></i></button></form></td>
    </tr>}</tbody>
</table></div></div>

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - El Cortijo</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="d-flex min-vh-100">
        <aside class="sidebar d-flex flex-column">
            <div class="brand d-flex align-items-center gap-2">
                <div class="bg-primary text-white p-2 rounded-3 d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                    <i class="bi bi-box-seam-fill"></i>
                </div>
                <div>
                    <h6 class="mb-0 fw-bold text-white">El Cortijo</h6>
                    <small class="text-secondary" style="font-size: 0.75rem;">Ventas & Inventario</small>
                </div>
            </div>

            <nav class="sidebar-nav flex-grow-1">
                <div class="sidebar-heading">Principal</div>
                <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-speedometer2"></i> Dashboard
                </a>

                @if (User.IsInRole("Administrador") || User.IsInRole("Vendedor"))
                {
                    <div class="sidebar-heading">Área Comercial</div>
                    <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Ventas" ? "active" : "")" asp-controller="Ventas" asp-action="Index">
                        <i class="bi bi-cart-check"></i> Ventas & Pedidos
                    </a>
                    <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Clientes" ? "active" : "")" asp-controller="Clientes" asp-action="Index">
                        <i class="bi bi-people"></i> Clientes
                    </a>
                    <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Comprobantes" ? "active" : "")" asp-controller="Comprobantes" asp-action="Index">
                        <i class="bi bi-receipt"></i> Comprobantes & Caja
                    </a>
                }

                @if (User.IsInRole("Administrador") || User.IsInRole("Almacenero"))
                {
                    <div class="sidebar-heading">Logística & Almacén</div>
                    <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Productos" ? "active" : "")" asp-controller="Productos" asp-action="Index">
                        <i class="bi bi-boxes"></i> Catálogo de Alimentos
                    </a>
                    <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Kardex" ? "active" : "")" asp-controller="Kardex" asp-action="Index">
                        <i class="bi bi-arrow-left-right"></i> Movimientos / Kardex
                    </a>
                }

                @if (User.IsInRole("Administrador"))
                {
                    <div class="sidebar-heading">Administración</div>
                    <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Usuarios" ? "active" : "")" asp-controller="Usuarios" asp-action="Index">
                        <i class="bi bi-person-gear"></i> Usuarios & Roles
                    </a>
                    <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Reportes" ? "active" : "")" asp-controller="Reportes" asp-action="Index">
                        <i class="bi bi-graph-up-arrow"></i> Reportes Generales
                    </a>
                }
            </nav>

            <div class="p-3 border-top border-secondary border-opacity-25">
                <div class="d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center gap-2">
                        <div class="bg-secondary rounded-circle text-white d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; font-size: 0.85rem;">
                            <i class="bi bi-person"></i>
                        </div>
                        <div class="overflow-hidden" style="max-width: 130px;">
                            <p class="mb-0 text-white small fw-bold text-truncate">@User.Identity?.Name</p>
                            <span class="badge bg-secondary text-uppercase" style="font-size: 0.65rem;">
                                @(User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value ?? "Usuario")
                            </span>
                        </div>
                    </div>
                    <a asp-controller="Auth" asp-action="Logout" class="btn btn-sm btn-outline-light" title="Cerrar Sesión">
                        <i class="bi bi-box-arrow-right"></i>
                    </a>
                </div>
            </div>
        </aside>

        <div class="main-content">
            <header class="top-navbar d-flex justify-content-between align-items-center">
                <h5 class="mb-0 text-dark fw-bold">@ViewData["Title"]</h5>
                <div class="d-flex align-items-center gap-3">
                    <span class="text-muted small">
                        <i class="bi bi-calendar3 me-1"></i> @DateTime.Now.ToString("dd/MM/yyyy")
                    </span>
                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1">
                        <i class="bi bi-circle-fill me-1" style="font-size: 0.5rem;"></i> Sistema Operativo
                    </span>
                </div>
            </header>

            <main class="content-body">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@model ElCortijo.Web.ViewModels.LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Iniciar Sesión - Distribuidora El Cortijo";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        :root {
            --cortijo-primary: #1e3a8a;
            --cortijo-secondary: #f59e0b;
            --cortijo-dark: #0f172a;
            --cortijo-surface: #ffffff;
            --cortijo-bg: #f1f5f9;
        }

        body {
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #1e3a8a 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: system-ui, -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            margin: 0;
            padding: 20px;
        }

        .login-card {
            background: rgba(255, 255, 255, 0.96);
            border-radius: 16px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.35);
            max-width: 440px;
            width: 100%;
            padding: 2.5rem;
            backdrop-filter: blur(8px);
        }

        .brand-badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 64px;
            height: 64px;
            background: linear-gradient(135deg, #1e3a8a, #3b82f6);
            color: #ffffff;
            border-radius: 16px;
            font-size: 28px;
            margin-bottom: 1rem;
            box-shadow: 0 8px 16px rgba(30, 58, 138, 0.3);
        }

        .btn-cortijo {
            background-color: var(--cortijo-primary);
            color: #ffffff;
            border: none;
            padding: 12px;
            font-weight: 600;
            border-radius: 8px;
            transition: all 0.2s ease;
        }

        .btn-cortijo:hover {
            background-color: #1d4ed8;
            color: #ffffff;
            transform: translateY(-1px);
        }

        .form-floating > .form-control:focus ~ label {
            color: var(--cortijo-primary);
        }

        .form-control:focus {
            border-color: var(--cortijo-primary);
            box-shadow: 0 0 0 0.25rem rgba(30, 58, 138, 0.15);
        }
    </style>
</head>
<body>
    <div class="login-card">
        <div class="text-center">
            <div class="brand-badge">
                <i class="bi bi-box-seam-fill"></i>
            </div>
            <h3 class="fw-bold text-dark mb-1">Distribuidora El Cortijo</h3>
            <p class="text-muted small mb-4">Sistema de Ventas y Control de Inventario</p>
        </div>

        @if (!string.IsNullOrEmpty(Model?.MensajeError))
        {
            <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                <div class="small">@Model.MensajeError</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <form asp-action="Login" method="post">
            <input type="hidden" asp-for="ReturnUrl" />

            <div class="form-floating mb-3">
                <input asp-for="NombreUsuarioOCorreo" class="form-control" id="txtUsuario" placeholder="usuario o correo" autofocus />
                <label asp-for="NombreUsuarioOCorreo"><i class="bi bi-person me-1"></i> Usuario o Correo</label>
                <span asp-validation-for="NombreUsuarioOCorreo" class="text-danger small"></span>
            </div>

            <div class="form-floating mb-4">
                <input asp-for="Clave" type="password" class="form-control" id="txtClave" placeholder="contraseña" />
                <label asp-for="Clave"><i class="bi bi-lock me-1"></i> Contraseña</label>
                <span asp-validation-for="Clave" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-cortijo w-100 mb-3">
                <i class="bi bi-box-arrow-in-right me-1"></i> Iniciar Sesión
            </button>
        </form>

        <div class="border-top pt-3 text-center">
            <span class="text-muted small">EFSRT V - CIBERTEC 2026</span>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

@model ElCortijo.Web.ViewModels.ComprobantesIndexViewModel
@{
    ViewData["Title"] = "Comprobantes";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div><h2 class="fw-bold mb-1">Boletas y facturas</h2><p class="text-muted mb-0">Consulta comprobantes asociados a ventas existentes.</p></div>
</div>
<form method="get" asp-action="Index" class="card card-body border-0 shadow-sm mb-4">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="row g-3 align-items-end">
        <div class="col-md-3"><label asp-for="Numero" class="form-label">Número</label><input asp-for="Numero" class="form-control" maxlength="20" /></div>
        <div class="col-md-2"><label asp-for="Tipo" class="form-label">Tipo</label><select asp-for="Tipo" class="form-select"><option value="">Todos</option><option value="Boleta">Boleta</option><option value="Factura">Factura</option></select></div>
        <div class="col-md-2"><label asp-for="Desde" class="form-label">Desde</label><input asp-for="Desde" class="form-control" /></div>
        <div class="col-md-2"><label asp-for="Hasta" class="form-label">Hasta</label><input asp-for="Hasta" class="form-control" /><span asp-validation-for="Hasta" class="text-danger small"></span></div>
        <div class="col-md-3 d-flex gap-2"><button class="btn btn-primary" type="submit"><i class="bi bi-search me-1"></i>Buscar</button><a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a></div>
    </div>
</form>
<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light"><tr><th>Fecha</th><th>Número</th><th>Tipo</th><th>Cliente</th><th>Estado</th><th class="text-end">Total registrado</th><th></th></tr></thead>
            <tbody>
                @if (Model.Comprobantes.Count == 0)
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">No se encontraron comprobantes para los filtros indicados.</td></tr>
                }
                else
                {
                    @foreach (var item in Model.Comprobantes)
                    {
                        <tr><td>@item.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</td><td class="fw-semibold">@item.NumeroComprobante</td><td>@item.TipoComprobante</td><td>@(item.ClienteNombre ?? "Cliente no disponible")</td><td>@item.Estado</td><td class="text-end">S/ @item.Total.ToString("N2")</td><td class="text-end"><a asp-action="Detalle" asp-route-id="@item.IdVenta" class="btn btn-sm btn-outline-primary">Ver</a></td></tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
<p class="form-text mt-2">Se muestran como máximo 500 comprobantes; usa filtros de fecha o número para acotar la consulta.</p>

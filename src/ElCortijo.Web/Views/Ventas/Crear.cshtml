@model ElCortijo.Dominio.DTOs.VentaRegistroViewModel
@using ElCortijo.Dominio.Entidades
@{ ViewData["Title"] = "Nueva venta"; var productos = (IEnumerable<Producto>)ViewBag.Productos; }
<div class="d-flex justify-content-between align-items-center mb-4"><div><h2 class="fw-bold mb-1">Armar pedido</h2><p class="text-muted small mb-0">El stock se descuenta al confirmar la venta.</p></div><a asp-action="Index" class="btn btn-outline-secondary">Volver</a></div>
<form asp-action="Crear" method="post"><div asp-validation-summary="ModelOnly" class="alert alert-danger"></div><div class="row g-4"><div class="col-lg-8"><div class="card border-0 shadow-sm"><div class="card-body"><h5 class="fw-bold">Productos</h5><div class="row g-2 mb-3"><div class="col-md-8"><select id="producto" class="form-select"><option value="">Seleccione un producto</option>@foreach (var p in productos) { <option value="@p.IdProducto" data-nombre="@p.Nombre" data-precio="@p.PrecioVenta" data-stock="@p.StockActual">@p.Nombre — S/ @p.PrecioVenta.ToString("N2") (Stock: @p.StockActual)</option>}</select></div><div class="col-md-2"><input id="cantidad" type="number" min="1" value="1" class="form-control" /></div><div class="col-md-2"><button id="agregar" type="button" class="btn btn-outline-primary w-100">Agregar</button></div></div><div class="table-responsive"><table class="table"><thead><tr><th>Producto</th><th>Precio</th><th>Cant.</th><th class="text-end">Subtotal</th><th></th></tr></thead><tbody id="carrito"><tr id="vacio"><td colspan="5" class="text-center text-muted py-4">Aún no hay productos en el pedido.</td></tr></tbody></table></div></div></div></div>
<div class="col-lg-4"><div class="card border-0 shadow-sm"><div class="card-body"><h5 class="fw-bold mb-3">Datos de venta</h5><label asp-for="IdCliente" class="form-label">Cliente</label><select asp-for="IdCliente" asp-items="ViewBag.Clientes" class="form-select mb-3"><option value="">Seleccione un cliente</option></select><label asp-for="TipoComprobante" class="form-label">Comprobante</label><select asp-for="TipoComprobante" class="form-select mb-3"><option>Boleta</option><option>Factura</option></select><label asp-for="MetodoPago" class="form-label">Método de pago</label><select asp-for="MetodoPago" class="form-select mb-3" id="metodoPago"><option>Efectivo</option><option>Yape/Plin</option><option>Tarjeta</option><option>Transferencia</option></select><div id="recibidoGrupo"><label asp-for="MontoRecibido" class="form-label">Monto recibido</label><input asp-for="MontoRecibido" class="form-control mb-3" type="number" min="0" step="0.01" /></div><div class="border-top pt-3 d-flex justify-content-between"><span class="fw-bold">Total</span><span id="total" class="fw-bold fs-5">S/ 0.00</span></div><button class="btn btn-primary w-100 mt-4"><i class="bi bi-check-circle me-1"></i> Confirmar venta</button></div></div></div></div></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /><script>
const carrito = [], tbody = document.getElementById('carrito');
function render() { tbody.innerHTML = carrito.length ? carrito.map((i,n) => `<tr><td>${i.nombre}<input type="hidden" name="Items[${n}].IdProducto" value="${i.id}"></td><td>S/ ${i.precio.toFixed(2)}</td><td>${i.cantidad}<input type="hidden" name="Items[${n}].Cantidad" value="${i.cantidad}"></td><td class="text-end">S/ ${(i.precio*i.cantidad).toFixed(2)}</td><td><button type="button" class="btn btn-sm btn-outline-danger" onclick="quitar(${n})"><i class="bi bi-trash"></i></button></td></tr>`).join('') : '<tr><td colspan="5" class="text-center text-muted py-4">Aún no hay productos en el pedido.</td></tr>'; document.getElementById('total').textContent = 'S/ ' + carrito.reduce((s,i)=>s+i.precio*i.cantidad,0).toFixed(2); }
function quitar(n) { carrito.splice(n,1); render(); } window.quitar = quitar;
document.getElementById('agregar').onclick = () => { const s=document.getElementById('producto'), o=s.selectedOptions[0], c=Number(document.getElementById('cantidad').value); if (!s.value || !Number.isInteger(c) || c < 1) return; const exist=carrito.find(i=>i.id==s.value); if ((exist?exist.cantidad:0)+c > Number(o.dataset.stock)) { alert('La cantidad supera el stock disponible.'); return; } if(exist) exist.cantidad+=c; else carrito.push({id:s.value,nombre:o.dataset.nombre,precio:Number(o.dataset.precio),cantidad:c}); render(); };
document.getElementById('metodoPago').onchange = e => { document.getElementById('recibidoGrupo').style.display = e.target.value === 'Efectivo' ? 'block' : 'none'; }; render();
</script> }

@model IEnumerable<ElCortijo.Dominio.Entidades.Venta>
@{ ViewData["Title"] = "Ventas y pedidos"; }
<div class="d-flex justify-content-between align-items-center mb-4"><div><h2 class="fw-bold mb-1">Ventas y pedidos</h2><p class="text-muted small mb-0">Historial de ventas confirmadas</p></div><a asp-action="Crear" class="btn btn-primary"><i class="bi bi-cart-plus-fill me-1"></i> Nueva venta</a></div>
@if (TempData["Exito"] is string mensaje) { <div class="alert alert-success">@mensaje</div> }
<div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead class="table-light"><tr><th>Comprobante</th><th>Cliente</th><th>Productos</th><th>Pago</th><th>Total</th><th>Fecha</th></tr></thead><tbody>
@foreach (var venta in Model) { <tr><td class="fw-semibold">@venta.NumeroComprobante<br /><small class="text-muted">@venta.TipoComprobante</small></td><td>@venta.Cliente.NombreRazonSocial</td><td>@venta.DetalleVentas.Sum(d => d.Cantidad) artículos</td><td>@venta.MetodoPago</td><td class="fw-bold">S/ @venta.Total.ToString("N2")</td><td>@venta.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</td></tr> }
</tbody></table></div></div>

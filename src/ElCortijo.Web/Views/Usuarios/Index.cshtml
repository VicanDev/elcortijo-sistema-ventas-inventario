@model IEnumerable<ElCortijo.Dominio.DTOs.UsuarioDto>
@{
    ViewData["Title"] = "Gestión de Usuarios";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold text-dark mb-1">Usuarios del Sistema</h2>
        <p class="text-muted small mb-0">Administración de credenciales y roles de acceso</p>
    </div>
    <a asp-action="Crear" class="btn btn-primary">
        <i class="bi bi-person-plus-fill me-1"></i> Nuevo Usuario
    </a>
</div>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Usuario</th>
                    <th>Nombre Completo</th>
                    <th>Correo</th>
                    <th>Rol</th>
                    <th>Teléfono</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    <tr>
                        <td class="fw-semibold">@u.NombreUsuario</td>
                        <td>@u.NombreCompleto</td>
                        <td>@u.Correo</td>
                        <td>
                            <span class="badge bg-primary">@u.RolNombre</span>
                        </td>
                        <td>@(u.Telefono ?? "-")</td>
                        <td>
                            @if (u.Estado)
                            {
                                <span class="badge bg-success">Activo</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactivo</span>
                            }
                        </td>
                        <td class="text-end">
                            <form asp-action="CambiarEstado" asp-route-id="@u.IdUsuario" method="post" class="d-inline">
                                @if (u.Estado)
                                {
                                    <button type="submit" class="btn btn-sm btn-outline-warning" title="Desactivar">
                                        <i class="bi bi-slash-circle"></i>
                                    </button>
                                }
                                else
                                {
                                    <button type="submit" class="btn btn-sm btn-outline-success" title="Activar">
                                        <i class="bi bi-check-circle"></i>
                                    </button>
                                }
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

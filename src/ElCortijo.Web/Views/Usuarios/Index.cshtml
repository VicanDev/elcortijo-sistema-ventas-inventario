@model IEnumerable<ElCortijo.Dominio.DTOs.UsuarioDto>
@{ ViewData["Title"] = "Gestion de usuarios"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <div><h2 class="fw-bold text-dark mb-1">Usuarios del sistema</h2><p class="text-muted small mb-0">Administracion de credenciales y roles de acceso</p></div>
    <a asp-action="Crear" class="btn btn-primary"><i class="bi bi-person-plus-fill me-1"></i> Nuevo usuario</a>
</div>

<form method="get" class="card border-0 shadow-sm mb-4 filter-card"><div class="card-body p-4">
    <div class="d-flex align-items-center gap-2 mb-3"><i class="bi bi-funnel-fill text-primary"></i><h6 class="fw-bold mb-0">Filtros de busqueda</h6></div>
    <div class="filter-grid">
        <div class="filter-control filter-control-wide"><label class="filter-label" for="buscar">BUSCAR USUARIO</label><div class="input-group"><span class="input-group-text bg-white"><i class="bi bi-search text-muted"></i></span><input id="buscar" name="buscar" value="@ViewBag.Buscar" class="form-control" placeholder="Usuario, nombre o correo" /></div></div>
        <div class="filter-control"><label class="filter-label" for="idRol">ROL</label><select id="idRol" name="idRol" class="form-select"><option value="">Todos los roles</option>@foreach (var rol in (IEnumerable<ElCortijo.Dominio.Entidades.Rol>)ViewBag.RolesFiltro) { <option value="@rol.IdRol" selected="@(ViewBag.IdRol == rol.IdRol)">@rol.Nombre</option> }</select></div>
        <div class="filter-control filter-control-small"><label class="filter-label" for="estado">ESTADO</label><select id="estado" name="estado" class="form-select"><option value="">Todos</option><option value="activo" selected="@(ViewBag.Estado == "activo")">Activo</option><option value="inactivo" selected="@(ViewBag.Estado == "inactivo")">Inactivo</option></select></div>
        <div class="filter-actions"><a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-funnel-slash me-1"></i> Limpiar</a><button class="btn btn-primary" type="submit"><i class="bi bi-search me-1"></i> Buscar</button></div>
    </div>
</div></form>

<div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table table-hover align-middle mb-0">
    <thead class="table-light"><tr><th>Usuario</th><th>Nombre completo</th><th>Correo</th><th>Rol</th><th>Telefono</th><th>Estado</th><th class="text-end">Acciones</th></tr></thead>
    <tbody>
    @if (Model.Any())
    {
        foreach (var usuario in Model)
        {
            <tr>
                <td class="fw-semibold">@usuario.NombreUsuario</td><td>@usuario.NombreCompleto</td><td>@usuario.Correo</td>
                <td><span class="badge bg-primary">@usuario.RolNombre</span></td><td>@(usuario.Telefono ?? "-")</td>
                <td><span class="badge @(usuario.Estado ? "bg-success" : "bg-secondary")">@(usuario.Estado ? "Activo" : "Inactivo")</span></td>
                <td class="text-end"><form asp-action="CambiarEstado" asp-route-id="@usuario.IdUsuario" method="post" class="d-inline"><button type="submit" class="btn btn-sm @(usuario.Estado ? "btn-outline-warning" : "btn-outline-success")" title="@(usuario.Estado ? "Desactivar" : "Activar")"><i class="bi @(usuario.Estado ? "bi-slash-circle" : "bi-check-circle")"></i></button></form></td>
            </tr>
        }
    }
    else
    {
        <tr><td colspan="7" class="text-center text-muted py-4"><i class="bi bi-search d-block fs-3 mb-2"></i>No se encontraron usuarios con los filtros seleccionados.</td></tr>
    }
    </tbody>
</table></div></div>
